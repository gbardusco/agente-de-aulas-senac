{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Relatorio docente canonico v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "aulaId", "atualizadoEm", "sistema", "campos", "evidencias", "fontes", "historico"],
    "properties": {
        "version": { "const": 1 },
        "aulaId": { "type": "string", "pattern": "^aula-[0-9]{2,3}$" },
        "atualizadoEm": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "sistema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instituicao", "sistema", "manual", "manualVersao"],
            "properties": {
                "instituicao": { "type": "string", "minLength": 1, "maxLength": 120 },
                "sistema": { "type": "string", "minLength": 1, "maxLength": 120 },
                "manual": { "type": "string", "minLength": 1, "maxLength": 160 },
                "manualVersao": { "type": "string", "minLength": 1, "maxLength": 80 },
                "revisadoEm": { "type": "string", "maxLength": 80 }
            }
        },
        "campos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "rotulo", "grupo", "obrigatorio", "valor"],
                "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){0,7}$" },
                    "rotulo": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "grupo": { "enum": ["configuracao", "evidencia", "diario", "feedback", "personalizado"] },
                    "obrigatorio": { "type": "boolean" },
                    "limiteCaracteres": { "type": ["integer", "null"], "minimum": 0, "maximum": 20000 },
                    "instrucoes": { "type": "string", "maxLength": 2000 },
                    "valor": { "type": "string", "maxLength": 20000 }
                }
            }
        },
        "evidencias": {
            "type": "array",
            "maxItems": 200,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "descricao", "situacao"],
                "properties": {
                    "id": { "type": "string", "pattern": "^evidencia-[0-9]{2,3}-[a-z0-9-]{1,64}$" },
                    "descricao": { "type": "string", "minLength": 1, "maxLength": 2000 },
                    "atividadeId": { "type": "string", "pattern": "^atividade-[0-9]{2,3}-[a-z0-9-]{1,64}$" },
                    "criterio": { "type": "string", "maxLength": 500 },
                    "indicador": { "type": "string", "maxLength": 500 },
                    "fonteId": { "type": "string", "pattern": "^fonte-[a-z0-9-]{1,80}$" },
                    "data": { "type": "string", "maxLength": 80 },
                    "situacao": { "enum": ["planejada", "observada", "confirmada", "pendente"] },
                    "resultado": { "type": "string", "maxLength": 2000 }
                }
            }
        },
        "fontes": {
            "type": "array",
            "maxItems": 100,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "titulo", "tipo", "situacaoLeitura", "dataConsulta"],
                "properties": {
                    "id": { "type": "string", "pattern": "^fonte-[a-z0-9-]{1,80}$" },
                    "titulo": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "tipo": { "enum": ["oficial", "manual", "primaria", "complementar"] },
                    "autor": { "type": "string", "maxLength": 160 },
                    "versaoData": { "type": "string", "maxLength": 80 },
                    "local": { "type": "string", "maxLength": 300 },
                    "secao": { "type": "string", "maxLength": 200 },
                    "situacaoLeitura": { "enum": ["nao-lido", "consultado", "parcial", "nao-processado"] },
                    "dataConsulta": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "aplicabilidade": { "type": "string", "maxLength": 1000 },
                    "restricoes": { "type": "string", "maxLength": 1000 }
                }
            }
        },
        "historico": {
            "type": "array",
            "maxItems": 200,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["quando", "acao"],
                "properties": {
                    "quando": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "acao": { "type": "string", "minLength": 1, "maxLength": 500 },
                    "ator": { "type": "string", "maxLength": 160 },
                    "detalhe": { "type": "string", "maxLength": 2000 }
                }
            }
        }
    }
}
