    "slides": [
        {
            "title": "Problema: organizar um catálogo",
            "blocks": [
                {
                    "type": "problema",
                    "contexto": "O catálogo fictício mistura título e descrição dos produtos, dificultando a leitura.",
                    "questao": "Como separar essas informações com estrutura semântica?"
                }
            ]
        },
        {
            "title": "Conceito: estrutura semântica",
            "blocks": [
                {
                    "type": "conceito",
                    "items": ["Títulos organizam a hierarquia do documento.", "Parágrafos agrupam o texto descritivo."]
                }
            ],
            "notes": "Confirmar o alinhamento com o Plano de Curso. Esta nota também aparece no HTML."
        },
        {
            "title": "Aplicação prática",
            "blocks": [
                {
                    "type": "aplicacao",
                    "modalidade": "pratica",
                    "texto": "Construa uma página sintética com título e descrição do produto fictício.",
                    "codigo": "<article>\n    <h2>Caderno</h2>\n</article>",
                    "demonstracao": {
                        "texto": "Referência oficial: elemento article",
                        "url": "https://html.spec.whatwg.org/multipage/sections.html#the-article-element"
                    }
                }
            ]
        },
        {
            "title": "Síntese",
            "blocks": [
                {
                    "type": "sintese",
                    "items": ["Estrutura semântica separa título e descrição.", "A mesma estratégia vale para outros catálogos fictícios."]
                }
            ]
        }
    ]
