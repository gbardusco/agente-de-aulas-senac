{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Fonte compartilhada de slides v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "title", "slides"],
    "properties": {
        "version": { "const": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slides": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "blocks"],
                "properties": {
                    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "notes": { "type": "string", "maxLength": 2000 },
                    "blocks": {
                        "type": "array", "minItems": 1, "maxItems": 4,
                        "items": {
                            "oneOf": [
                                {
                                    "type": "object", "additionalProperties": false,
                                    "required": ["type", "text"],
                                    "properties": {
                                        "type": { "enum": ["text", "code", "callout"] },
                                        "text": { "type": "string", "minLength": 1, "maxLength": 600 }
                                    }
                                },
                                {
                                    "type": "object", "additionalProperties": false,
                                    "required": ["type", "items"],
                                    "properties": {
                                        "type": { "const": "bullets" },
                                        "items": {
                                            "type": "array", "minItems": 1, "maxItems": 6,
                                            "items": { "type": "string", "minLength": 1, "maxLength": 150 }
                                        }
                                    }
                                },
                                {
                                    "type": "object", "additionalProperties": false,
                                    "required": ["type", "text", "url"],
                                    "properties": {
                                        "type": { "const": "demo" },
                                        "text": { "type": "string", "minLength": 1, "maxLength": 150 },
                                        "url": { "type": "string", "pattern": "^https://[^\\s<>\"\\\\]+$", "maxLength": 200 }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    }
}
